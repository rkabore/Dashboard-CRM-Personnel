# ============================================================
#  Dashboard CRM Personnel — Variables d'environnement
#  Copier ce fichier en .env.local et renseigner les valeurs.
#  NE PAS committer .env.local (déjà dans .gitignore).
# ============================================================

# --- Application -----------------------------------------
# URL publique de l'application (utilisée pour les meta tags og:url)
# Vercel l'injecte automatiquement via VERCEL_URL en production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environnement courant : development | production
NEXT_PUBLIC_APP_ENV=development

# --- Feature flags (phases de la roadmap) ----------------
# Mettre à "true" pour activer les fonctionnalités d'une phase.
# Phase 1 (MVP) est toujours active.
NEXT_PUBLIC_ENABLE_PHASE2=false
NEXT_PUBLIC_ENABLE_PHASE3=false

# --- Pipeline pondéré — Phase 3 --------------------------
# Probabilités de conversion par statut (valeurs en %, 0–100).
# Modifiables ici ou via les sliders du simulateur.
# Voir ARCHITECTURE.md §10 pour la discussion sur ces valeurs.
NEXT_PUBLIC_PROB_PROSPECT=10
NEXT_PUBLIC_PROB_QUALIFIE=25
NEXT_PUBLIC_PROB_NEGOCIATION=60
NEXT_PUBLIC_PROB_GAGNE=100
NEXT_PUBLIC_PROB_A_RELANCER=15

# --- Déploiement Vercel (optionnel en local) -------------
# Injectées automatiquement par Vercel CI/CD — ne pas renseigner manuellement.
# VERCEL_URL=        # URL de preview générée par Vercel
# VERCEL_ENV=        # preview | production
